############################################
# AI Agent (.env.example)
# Copy to .env and fill in real values.
# Do NOT commit .env.
############################################

# Anthropic
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-sonnet-4-6
PLANNING_MODEL=claude-opus-4-6

# Optional: auth for the agent HTTP API (recommended if exposed beyond localhost)
AGENT_AUTH_TOKEN=

# Allow the agent to write its own measurement(s) for display panels
# (does not affect how readiness is computed; computations stay raw-Garmin-only)
AI_ALLOW_DB_WRITE=false

# InfluxDB (recommended: separate read-only user for the agent)
AI_INFLUXDB_USERNAME=influxdb_user
AI_INFLUXDB_PASSWORD=influxdb_secret_password
AI_INFLUXDB_DATABASE=GarminStats

# Grafana (optional, for API push)
# If the agent runs in Docker Compose, prefer the internal service URL:
GRAFANA_URL=http://grafana:3000
GRAFANA_API_TOKEN=

