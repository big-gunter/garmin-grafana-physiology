############################################
# Garmin Grafana stack (.env.example)
# Copy to .env and fill in real values.
# Do NOT commit .env.
############################################

# --- InfluxDB (shared by garmin-fetch-data; use same vars for CLI / future MCP read client)
INFLUXDB_VERSION=1
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_USERNAME=influxdb_user
INFLUXDB_PASSWORD=influxdb_secret_password
INFLUXDB_DATABASE=GarminStats
INFLUXDB_ENDPOINT_IS_HTTP=true

# Optional: dedicated READ-only user for MCP / automation (create in Influx with GRANT READ …)
# MCP_INFLUX_USERNAME=mcp_reader
# MCP_INFLUX_PASSWORD=

# --- Grafana HTTP API (optional — for MCP dashboard tools or scripts)
# Create token in Grafana: Administration → Service accounts (or API keys)
GRAFANA_URL=http://grafana:3000
GRAFANA_API_TOKEN=

# --- Future: MCP HTTP gateway (if you expose MCP beyond localhost)
# MCP_AUTH_TOKEN=
