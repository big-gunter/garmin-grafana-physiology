          "refId": "D",
          "resultFormat": "table"
        },
        {
          "alias": "Zone 5",
          "query": "SELECT last(\"Z5_Low\") AS \"HR Low\", last(\"Z5_High\") AS \"HR High\" FROM \"PhysiologyDaily\" WHERE $timeFilter",
          "rawQuery": true,
          "refId": "E",
