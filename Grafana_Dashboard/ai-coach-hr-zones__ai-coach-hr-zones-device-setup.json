      "targets": [
        {
          "alias": "Zone 1",
          "query": "SELECT last(\"Z1_Low\") AS \"HR Low\", last(\"Z1_High\") AS \"HR High\" FROM \"PhysiologyDaily\" WHERE $timeFilter",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "table"
        },
        {
          "alias": "Zone 2",
          "query": "SELECT last(\"Z2_Low\") AS \"HR Low\", last(\"Z2_High\") AS \"HR High\" FROM \"PhysiologyDaily\" WHERE $timeFilter",
