        },
        {
          "alias": "Zone 3",
          "query": "SELECT last(\"Z3_Low\") AS \"HR Low\", last(\"Z3_High\") AS \"HR High\" FROM \"PhysiologyDaily\" WHERE $timeFilter",
          "rawQuery": true,
