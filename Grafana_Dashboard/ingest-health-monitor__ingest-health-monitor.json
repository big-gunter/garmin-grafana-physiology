    {
      "datasource": {
        "type": "influxdb",
        "uid": "garmin_influxdb"
      },
      "description": "Steps, HR, stress, body battery. Red if no data in 48h.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "index": 0,
                  "text": "\u26a0 STALE"
                }
              },
              "type": "value"
