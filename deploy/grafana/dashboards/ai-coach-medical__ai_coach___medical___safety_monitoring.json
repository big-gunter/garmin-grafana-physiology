{
  "dashboard": {
    "panels": [
      {
        "datasource": {
          "type": "influxdb",
          "uid": "garmin_influxdb"
        },
        "description": "Watch for sustained readings below 93%. APCKD context.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "fillOpacity": 10,
              "lineWidth": 2
            },
            "max": 100,
            "min": 88,
            "unit": "percent"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "targets": [
          {
            "alias": "SpO2 Daily Avg",
            "query": "SELECT mean(\"averageSpo2\") FROM \"DailyStats\" WHERE time >= now() - 30d GROUP BY time(1d) fill(null)",
            "rawQuery": true,
            "refId": "A"
          },
          {
            "alias": "SpO2 During Sleep",
            "query": "SELECT mean(\"averageSpO2Value\") FROM \"SleepSummary\" WHERE time >= now() - 30d GROUP BY time(1d) fill(null)",
            "rawQuery": true,
            "refId": "B"
          }
        ],
        "title": "SpO2 \u2014 Daily Average and Low",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "influxdb",
          "uid": "garmin_influxdb"
