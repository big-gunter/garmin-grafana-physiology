        "targets": [
          {
            "alias": "Coach Readiness \u2605",
            "query": "SELECT mean(\"coach_readiness\") FROM \"CoachReadiness\" WHERE $timeFilter GROUP BY time(1d) fill(null)",
            "rawQuery": true,
            "refId": "A"
          },
          {
            "alias": "HRV Component (40%)",
            "query": "SELECT mean(\"hrv_component\") FROM \"CoachReadiness\" WHERE $timeFilter GROUP BY time(1d) fill(null)",
