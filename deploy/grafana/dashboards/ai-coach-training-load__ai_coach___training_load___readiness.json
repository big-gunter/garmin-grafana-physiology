{
  "dashboard": {
    "panels": [
      {
        "datasource": {
          "type": "influxdb",
          "uid": "garmin_influxdb"
        },
        "description": "Primary readiness signal. Orange = composite. Components lighter. More reliable than WHOOP for athletes on beta-blockers.",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 5,
              "lineWidth": 1.5
            },
            "max": 100,
            "min": 0,
            "unit": "short"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Coach Readiness \u2605"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#f97316",
                    "mode": "fixed"
                  }
                },
                {
                  "id": "custom.lineWidth",
                  "value": 3
                },
                {
                  "id": "custom.fillOpacity",
                  "value": 15
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "HRV Component (40%)"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#8b5cf6",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Sleep Component (30%)"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#3b82f6",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
