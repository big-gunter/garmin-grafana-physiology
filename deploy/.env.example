# =============================================================================
# Cloud deployment environment variables
# Copy to deploy/.env and fill in all values
# chmod 600 deploy/.env
# NEVER commit the real .env to git
# =============================================================================

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- InfluxDB (v1.x) ---
INFLUX_PASSWORD=
INFLUX_DATABASE=GarminStats
INFLUX_MCP_PASSWORD=
INFLUX_WRITER_PASSWORD=

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=
# Service account token for MCP Grafana tools (see deploy/setup/05_grafana_token.md)
GRAFANA_TOKEN=

# --- Garmin Device ---
# Leave blank to match all devices
GARMIN_DEVICENAME=

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USER=

# --- MCP Server ---
# Generate with: openssl rand -hex 32
TOKEN_SECRET=

# --- MCP Server (ChatGPT-facing, mcp-gpt.big-gunter.com) ---
# Separate GitHub OAuth app with callback: https://mcp-gpt.big-gunter.com/oauth/callback
GITHUB_GPT_CLIENT_ID=
GITHUB_GPT_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
TOKEN_SECRET_GPT=

# --- Athlete Physiology (optional) ---
# When set, these override statistically-estimated values in PhysiologyDaily.
#
# ATHLETE_HRMAX: validated observed maximum HR (bpm).
#   Without this, HRmax is estimated from the p95 of activity maxHR over the
#   last 42 days — unreliable during low-training periods or on beta-blockers.
#   Set to your best credible observed max (e.g. from a hard race or hard interval).
#   The p95 estimate is still written as HRmax_p95_est for reference.
ATHLETE_HRMAX=183

# ATHLETE_RHR: resting HR floor used for Karvonen zone calculation (bpm).
#   Beta-blockers (atenolol) can suppress RHR below the true aerobic baseline.
#   The 7-day median from DailyStats is used when >= this floor; otherwise this
#   floor value is used. Set to your well-rested baseline without medication effect.
ATHLETE_RHR=47

# ATHLETE_LTHR: lactate threshold HR (bpm).
#   Stored as a reference field in PhysiologyDaily. Not yet used in zone calculation.
ATHLETE_LTHR=136

# --- WHOOP Integration (optional - requires --profile whoop) ---
# Register your app at: https://developer-dashboard.whoop.com
# Set the OAuth callback URL to: http://localhost:8080/callback
# See deploy/setup/06_whoop_auth.md for the full setup guide
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
