
cat > ~/Cursor\ Projects/garmin-grafana-physiology/deploy/.env.example << 'EOF'
# =============================================================================
# Cloud deployment environment variables
# Copy to /opt/physiology/.env on the server and fill in all values
# chmod 600 /opt/physiology/.env
# NEVER commit the real .env to git
# =============================================================================

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- InfluxDB (v1.x) ---
INFLUX_PASSWORD=
INFLUX_DATABASE=GarminStats
INFLUX_MCP_PASSWORD=

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=

# --- Garmin Device ---
# Leave blank to match all devices
GARMIN_DEVICENAME=

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USER=

# --- MCP Server ---
# Generate with: openssl rand -hex 32
TOKEN_SECRET=
