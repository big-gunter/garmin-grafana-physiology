# =============================================================================
# Cloud deployment environment variables
# Copy to deploy/.env and fill in all values
# chmod 600 deploy/.env
# NEVER commit the real .env to git
# =============================================================================

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- InfluxDB (v1.x) ---
INFLUX_PASSWORD=
INFLUX_DATABASE=GarminStats
INFLUX_MCP_PASSWORD=
INFLUX_WRITER_PASSWORD=

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=
# Service account token for MCP Grafana tools (see deploy/setup/05_grafana_token.md)
GRAFANA_TOKEN=

# --- Garmin Device ---
# Leave blank to match all devices
GARMIN_DEVICENAME=

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USER=

# --- MCP Server ---
# Generate with: openssl rand -hex 32
TOKEN_SECRET=

# --- MCP Server (ChatGPT-facing, mcp-gpt.big-gunter.com) ---
# Separate GitHub OAuth app with callback: https://mcp-gpt.big-gunter.com/oauth/callback
GITHUB_GPT_CLIENT_ID=
GITHUB_GPT_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
TOKEN_SECRET_GPT=

# --- Athlete Physiology ---
# Athlete physiological constants (HRmax, RHR floor, LTHR, Karvonen zones) are
# stored as versioned records in the AthleteProfile InfluxDB measurement — not as
# env vars.  Seed the initial record once after deploying:
#
#   docker compose exec garmin-fetch-data \
#     python /app/scripts/write_athlete_profile.py
#
# The garmin-fetch-data container loads the most recent AthleteProfile record at
# startup (falls back to hardcoded defaults if no record exists).  To update
# constants, run write_athlete_profile.py again with the new values and restart
# the container, then run compute_physiology_backfill.py --backfill.

# --- WHOOP Integration (optional - requires --profile whoop) ---
# Register your app at: https://developer-dashboard.whoop.com
# Set the OAuth callback URL to: http://localhost:8080/callback
# See deploy/setup/06_whoop_auth.md for the full setup guide
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
