# WireGuard client configuration for {{USERNAME}} stack
# Copy to deploy/.wireguard.{{USERNAME}}.env and fill in values:
#   cp deploy/template/.wireguard.env.template deploy/.wireguard.{{USERNAME}}.env
#   chmod 600 deploy/.wireguard.{{USERNAME}}.env
# NEVER commit this file to git (covered by .gitignore)
#
# After filling in values, generate wg0.conf:
#   bash /opt/{{USERNAME}}/wireguard/generate-wg0.sh

WG_PRIVATE_KEY=          # This peer's private key (wg genkey)
WG_ADDRESS=              # This peer's tunnel IP, e.g. 10.0.0.2/32
WG_DNS=                  # DNS to use through tunnel, e.g. 1.1.1.1
WG_PEER_PUBLIC_KEY=      # Server's public key (wg pubkey < server_private)
WG_PEER_ENDPOINT=        # Server's public IP/hostname and port, e.g. home.example.com:51820
WG_PEER_PRESHARED_KEY=   # Optional preshared key; leave blank if not used
WG_ALLOWED_IPS=0.0.0.0/0 # Route all traffic through tunnel
